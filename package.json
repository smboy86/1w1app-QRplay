{
  "name": "qrplay",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:go:tunnel": "expo start --go --tunnel",
    "android": "expo run:android",
    "android:sync": "expo prebuild --platform android --no-install",
    "android:clean": "expo run:android --clean",
    "build:aab": "npx eas build --platform android --profile production",
    "build:apk": "npx eas build --platform android --profile production-apk --local",
    "submit:android": "npx eas submit --platform android --profile production --latest",
    "release:android": "npx eas build --platform android --profile production --auto-submit",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "~15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.27",
    "expo-camera": "~55.0.20",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.8",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  },
  "private": true
}
