{
  "name": "qrplay",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:go:tunnel": "expo start --go --tunnel",
    "android": "expo run:android",
    "android:sync": "expo prebuild --platform android --no-install",
    "android:clean": "expo run:android --clean",
    "build:aab": "npx eas-cli@latest build --platform android --profile production",
    "build:apk": "npx eas-cli@latest build --platform android --profile production-apk --local",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production --latest",
    "release:android": "npx eas-cli@latest build --platform android --profile production --auto-submit",
    "update:production": "CI=1 npx eas-cli@latest update --channel production --environment production --platform android",
    "update:view": "npx eas-cli@latest channel:view production",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "~15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.4",
    "expo-camera": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  },
  "private": true
}
